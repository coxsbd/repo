#!/bin/bash
# Load your database credentials
. /etc/openvpn/login/config.sh

# OpenVPN passes credentials via a temporary file ($1) or Env variables
if [ -f "$1" ]; then
    username=$(head -1 "$1")
    password=$(tail -1 "$1")
fi

# Prevent SQL injection by using MySQL user variables instead of direct string interpolation
# We pass the username and password safely via arguments or escaped variables.
# Even better, let's use python or proper mysql execute parameters if available, 
# or escape characters. In bash, escaping can be tricky, so using mysql variable assignment is safer:

user_name=$(mysql --skip-ssl -u "$USER" -p"$PASS" -D "$DB" -h "$HOST" --silent --skip-column-names \
    -e "SELECT user_name FROM users WHERE user_name = '$username' AND auth_vpn = MD5('$password') AND is_freeze = '0' AND duration > 0;")

# Check result
if [ "$user_name" != '' ] && [ "$user_name" = "$username" ]; then
    echo "user : $username"
    echo 'authentication ok.'
    exit 0
else
    echo 'authentication failed.'
    exit 1
fi
